# Copy this file to env.local.zsh for machine-specific environment settings.
# It is sourced by ~/.zshenv after the shared env.zsh.

export TERMINAL=kitty

for dir in \
  "$HOME/.TinyTeX/bin/x86_64-linux" \
  /opt/x86_64-linux-musl-cross/bin \
  /opt/riscv64-linux-musl-cross/bin
do
  [[ -d "$dir" ]] && path=("$dir" $path)
done
unset dir
